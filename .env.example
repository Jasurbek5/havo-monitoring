# ---- Telegram ----
# @BotFather dan olingan token
BOT_TOKEN=
# polling = lokal ishlab chiqish (domen va HTTPS shart emas)
# webhook = server (HTTPS va domen kerak)
BOT_MODE=polling
# Faqat webhook rejimida: https://sizning-domeningiz.uz (oxirida "/" siz)
WEBHOOK_BASE_URL=
# Faqat webhook rejimida: 1-256 belgi, faqat A-Z a-z 0-9 _ -  (masalan: openssl rand -hex 24)
WEBHOOK_SECRET=

# ---- Havo ma'lumoti (OpenWeatherMap Air Pollution API) ----
OWM_API_KEY=

# ---- PostgreSQL (docker compose shu qiymatlardan DATABASE_URL yasaydi) ----
POSTGRES_USER=havo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=havo

# ---- Docker'siz lokal ishga tushirish uchun (compose bularni o'zi beradi) ----
DATABASE_URL=postgresql+asyncpg://havo:change-me@localhost:5432/havo
REDIS_URL=redis://localhost:6379/0
# Bo'sh qolsa REDIS_URL ishlatiladi
CELERY_BROKER_URL=
MEDIA_DIR=./media

# ---- Sozlamalar (ixtiyoriy, standart qiymatlar bilan) ----
FETCH_INTERVAL_MINUTES=30
READING_TTL_MINUTES=30
ALERT_THRESHOLD=150
ALERT_CLEAR_THRESHOLD=130
ALERT_REPEAT_HOURS=6
DAILY_DIGEST_HOUR=7
TIMEZONE=Asia/Tashkent
MAX_COMPLAINTS_PER_DAY=5
MAX_DISTRICT_DISTANCE_KM=100
LOG_LEVEL=INFO

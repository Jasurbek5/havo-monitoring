# Yengil rejim sozlamalari. Nusxa oling:  .env  nomi bilan shu (backend) papkada saqlang.
# Docker, PostgreSQL va Redis kerak emas.
LITE_MODE=true

# @BotFather dan olingan token
BOT_TOKEN=
# OpenWeatherMap kaliti
OWM_API_KEY=

# Baza: shu papkadagi oddiy fayl (havo.db). Uni o'chirsangiz, hamma ma'lumot tozalanadi.
DATABASE_URL=sqlite+aiosqlite:///./havo.db
MEDIA_DIR=./media
BOT_MODE=polling

# Admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
